### 页面 TypeScript 文件模板
```typescript
// pages/example/index.ts

interface PageData {
  title: string;
  loading: boolean;
  list: any[];
  userInfo: UserInfo | null;
}

interface PageOptions {
  id?: string;
  [key: string]: any;
}

Page<PageData, PageOptions>({
  /**
   * 页面的初始数据
   */
  data: {
    title: '',
    loading: false,
    list: [],
    userInfo: null
  },

  /**
   * 生命周期函数--监听页面加载
   */
  onLoad(options: PageOptions): void {
    console.log('页面加载', options);
    this.initPage();
  },

  /**
   * 生命周期函数--监听页面初次渲染完成
   */
  onReady(): void {
    // 页面初次渲染完成
  },

  /**
   * 生命周期函数--监听页面显示
   */
  onShow(): void {
    // 页面显示时执行
  },

  /**
   * 生命周期函数--监听页面隐藏
   */
  onHide(): void {
    // 页面隐藏时执行
  },

  /**
   * 生命周期函数--监听页面卸载
   */
  onUnload(): void {
    // 页面卸载时执行，清理资源
  },

  /**
   * 页面相关事件处理函数--监听用户下拉动作
   */
  onPullDownRefresh(): void {
    this.refreshData();
  },

  /**
   * 页面上拉触底事件的处理函数
   */
  onReachBottom(): void {
    this.loadMoreData();
  },

  /**
   * 用户点击右上角分享
   */
  onShareAppMessage(): WechatMiniprogram.Page.IShareAppMessageOption {
    return {
      title: this.data.title,
      path: `/pages/example/index`
    };
  },

  /**
   * 初始化页面
   */
  async initPage(): Promise<void> {
    try {
      this.setData({ loading: true });
      await this.fetchData();
    } catch (error) {
      console.error('页面初始化失败:', error);
      wx.showToast({
        title: '加载失败',
        icon: 'error'
      });
    } finally {
      this.setData({ loading: false });
    }
  },

  /**
   * 获取数据
   */
  async fetchData(): Promise<void> {
    // API 调用逻辑
  },

  /**
   * 刷新数据
   */
  async refreshData(): Promise<void> {
    await this.fetchData();
    wx.stopPullDownRefresh();
  },

  /**
   * 加载更多数据
   */
  async loadMoreData(): Promise<void> {
    // 分页加载逻辑
  },

  /**
   * 处理点击事件
   */
  handleItemTap(event: WechatMiniprogram.BaseEvent): void {
    const { dataset } = event.currentTarget;
    const { id } = dataset;
    
    wx.navigateTo({
      url: `/pages/detail/index?id=${id}`
    });
  }
});
```

### WXML 模板规范
```xml
<!-- pages/example/index.wxml -->
<view class="page">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 页面内容 -->
  <view class="content" wx:else>
    <!-- 头部 -->
    <view class="header">
      <text class="title">{{title}}</text>
    </view>

    <!-- 列表 -->
    <scroll-view 
      class="list-container" 
      scroll-y="{{true}}"
      enable-back-to-top="{{true}}"
    >
      <view 
        class="list-item" 
        wx:for="{{list}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bind:tap="handleItemTap"
      >
        <text class="item-title">{{item.title}}</text>
        <text class="item-desc">{{item.description}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <text>暂无数据</text>
  </view>
</view>
```

