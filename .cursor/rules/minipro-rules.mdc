  &::after {
    content: '';
    display: table;
    clear: both;
  }
}

// 响应式字体
@mixin responsive-font($min-size, $max-size) {
  font-size: calc(#{$min-size} + (#{$max-size} - #{$min-size}) * ((100vw - 320px) / (750 - 320)));
}

// 按钮样式
